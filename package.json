{
  "name": "upwind-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p worker && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "api": "wrangler d1 migrations apply DB --local && wrangler dev --port 8787",
    "test": "node --test src/homework/*.test.ts"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "motion": "^14.9.0",
    "page-flip": "2.0.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "survey-core": "^3.2.4",
    "survey-react-ui": "^3.2.4",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.2",
    "vite": "^7.3.0",
    "wrangler": "^4.157.0"
  }
}
