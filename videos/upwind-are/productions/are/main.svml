<?svml using="@hypit/markup@1"?>
<!-- Generated by tools/build_voice.py: edit LINES there, then re-run it. -->
<svml>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="spatial" from="@hypit/spatial@1"/>
  <import as="media" from="@hypit/media@1"/>
  <import as="asset" from="@hypit/media@1"/>
  <import as="mediaop" from="@hypit/media-operations@1"/>
  <import as="audio" from="@hypit/audio-track@1"/>
  <import as="fonts" from="@hypit/fontsource@1"/>
  <import as="upwind" from="@upwind/lesson-scene@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="html" from="@hypit/html-video@1"/>
  <import as="look" source="./look.svs"/>

  <time:Clock id="clock" frame-rate="30"/>
  <time:Timeline id="t" clock={clock} end="1824f">
    <time:Instant id="hook" at="0f"/>
    <time:Instant id="skit" at="84f"/>
    <time:Instant id="q1" at="93f"/>
    <time:Instant id="a1" at="174f"/>
    <time:Instant id="hush" at="210f"/>
    <time:Instant id="q2" at="300f"/>
    <time:Instant id="a2" at="396f"/>
    <time:Instant id="teach" at="482f"/>
    <time:Instant id="t1" at="488f"/>
    <time:Instant id="t2" at="550f"/>
    <time:Instant id="t3" at="642f"/>
    <time:Instant id="t3-stack" at="691f"/>
    <time:Instant id="tA" at="725f"/>
    <time:Instant id="tR" at="843f"/>
    <time:Instant id="tE" at="942f"/>
    <time:Instant id="redo" at="1057f"/>
    <time:Instant id="relabel" at="1060f"/>
    <time:Instant id="q3" at="1107f"/>
    <time:Instant id="rA" at="1188f"/>
    <time:Instant id="rR" at="1282f"/>
    <time:Instant id="rE" at="1390f"/>
    <time:Instant id="nice" at="1574f"/>
    <time:Instant id="cta" at="1671f"/>
    <time:Instant id="ctacard" at="1674f"/>
  </time:Timeline>
  <spatial:Canvas id="canvas" width="1080" height="1920"/>

  <fonts:Face id="nunito-700" package="@fontsource-variable/nunito" weight="700" style="normal"/>
  <fonts:Face id="nunito-900" package="@fontsource-variable/nunito" weight="900" style="normal"/>
  <fonts:Face id="lora-700" package="@fontsource-variable/lora" weight="700" style="normal"/>
  <media:FontStack id="body" primary={nunito-700}/>
  <media:FontStack id="heavy" primary={nunito-900}/>
  <media:FontStack id="serif" primary={lora-700}/>

  <upwind:Lesson id="lesson" timeline={t.timeline} within={canvas.bounds} during={t.window}
    font={body} heavy={heavy} serif={serif} tag="Speaking · Part 1">
    <upwind:Beat id="b-hook" kind="hook" text="Mẹo từ UpWind|3 bước để không *'đứng hình'* ở IELTS Speaking Part 1" at={t.hook}/>
    <upwind:Beat id="b-skit" kind="section" text="skit" at={t.skit}/>
    <upwind:Beat id="b-q1" kind="examiner" text="Do you enjoy cooking?" at={t.q1}/>
    <upwind:Beat id="b-a1" kind="candidate" text="Yes." at={t.a1}/>
    <upwind:Beat id="b-hush" kind="silence" text="...im lặng 3 giây" at={t.hush}/>
    <upwind:Beat id="b-q2" kind="examiner" text="Um... could you tell me why?" at={t.q2}/>
    <upwind:Beat id="b-a2" kind="candidate" text="Because... it's fun." at={t.a2}/>
    <upwind:Beat id="b-teach" kind="section" text="teach" at={t.teach}/>
    <upwind:Beat id="b-t1" kind="teach" text="Trả lời *1 câu* rồi im lặng?" at={t.t1}/>
    <upwind:Beat id="b-t2" kind="teach" text="Giám khảo không có gì để chấm *Fluency* cả." at={t.t2}/>
    <upwind:Beat id="b-t3" kind="teach" text="Kéo dài câu trả lời với công thức *A.R.E*" at={t.t3}/>
    <upwind:Beat id="b-t3-stack" kind="stack" text="A,R,E" at={t.t3-stack}/>
    <upwind:Beat id="b-tA-step" kind="step" text="A|Answer|Trả lời thẳng câu hỏi" at={t.tA}/>
    <upwind:Beat id="b-tA" kind="teach" text="*Answer* — trả lời thẳng, đừng vòng vo." at={t.tA}/>
    <upwind:Beat id="b-tR-step" kind="step" text="R|Reason|Nói lý do: vì sao?" at={t.tR}/>
    <upwind:Beat id="b-tR" kind="teach" text="*Reason* — thêm một lý do cho ý của bạn." at={t.tR}/>
    <upwind:Beat id="b-tE-step" kind="step" text="E|Example|Một ví dụ có thật" at={t.tE}/>
    <upwind:Beat id="b-tE" kind="teach" text="*Example* — kể một chuyện nhỏ của chính bạn." at={t.tE}/>
    <upwind:Beat id="b-redo" kind="section" text="redo" at={t.redo}/>
    <upwind:Beat id="b-relabel" kind="label" text="Làm lại với A.R.E" at={t.relabel}/>
    <upwind:Beat id="b-q3" kind="examiner" text="Do you enjoy cooking?" at={t.q3}/>
    <upwind:Beat id="b-rA" kind="candidate" step="A" text="Yes, I really do, especially at weekends." at={t.rA}/>
    <upwind:Beat id="b-rR" kind="candidate" step="R" text="It helps me relax after a long week of studying." at={t.rR}/>
    <upwind:Beat id="b-rE" kind="candidate" step="E" text="Last Sunday I cooked phở for my whole family. It took four hours, but everyone loved it!" at={t.rE}/>
    <upwind:Beat id="b-nice" kind="examiner" text="That sounds wonderful." at={t.nice}/>
    <upwind:Beat id="b-cta" kind="section" text="cta" at={t.cta}/>
    <upwind:Beat id="b-ctacard" kind="cta" text="Lưu lại để luyện mỗi ngày|Mỗi câu Part 1: Answer, Reason, Example|upwind.asia" at={t.ctacard}/>
  </upwind:Lesson>

  <asset:Audio id="vo-hook-file" src="./voice/hook.mp3"/>
  <mediaop:Normalize id="vo-hook" source={vo-hook-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <time:Window id="vo-hook-window" timeline={t.timeline} from={t.hook} for="74f"/>
  <asset:Audio id="vo-q1-file" src="./voice/q1.mp3"/>
  <mediaop:Normalize id="vo-q1" source={vo-q1-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <time:Window id="vo-q1-window" timeline={t.timeline} from={t.q1} for="66f"/>
  <asset:Audio id="vo-a1-file" src="./voice/a1.mp3"/>
  <mediaop:Normalize id="vo-a1" source={vo-a1-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <time:Window id="vo-a1-window" timeline={t.timeline} from={t.a1} for="24f"/>
  <asset:Audio id="vo-q2-file" src="./voice/q2.mp3"/>
  <mediaop:Normalize id="vo-q2" source={vo-q2-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <time:Window id="vo-q2-window" timeline={t.timeline} from={t.q2} for="81f"/>
  <asset:Audio id="vo-a2-file" src="./voice/a2.mp3"/>
  <mediaop:Normalize id="vo-a2" source={vo-a2-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <time:Window id="vo-a2-window" timeline={t.timeline} from={t.a2} for="56f"/>
  <asset:Audio id="vo-t1-file" src="./voice/t1.mp3"/>
  <mediaop:Normalize id="vo-t1" source={vo-t1-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <time:Window id="vo-t1-window" timeline={t.timeline} from={t.t1} for="52f"/>
  <asset:Audio id="vo-t2-file" src="./voice/t2.mp3"/>
  <mediaop:Normalize id="vo-t2" source={vo-t2-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <time:Window id="vo-t2-window" timeline={t.timeline} from={t.t2} for="82f"/>
  <asset:Audio id="vo-t3-file" src="./voice/t3.mp3"/>
  <mediaop:Normalize id="vo-t3" source={vo-t3-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <time:Window id="vo-t3-window" timeline={t.timeline} from={t.t3} for="71f"/>
  <asset:Audio id="vo-tA-file" src="./voice/tA.mp3"/>
  <mediaop:Normalize id="vo-tA" source={vo-tA-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <time:Window id="vo-tA-window" timeline={t.timeline} from={t.tA} for="106f"/>
  <asset:Audio id="vo-tR-file" src="./voice/tR.mp3"/>
  <mediaop:Normalize id="vo-tR" source={vo-tR-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <time:Window id="vo-tR-window" timeline={t.timeline} from={t.tR} for="87f"/>
  <asset:Audio id="vo-tE-file" src="./voice/tE.mp3"/>
  <mediaop:Normalize id="vo-tE" source={vo-tE-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <time:Window id="vo-tE-window" timeline={t.timeline} from={t.tE} for="91f"/>
  <asset:Audio id="vo-relabel-file" src="./voice/relabel.mp3"/>
  <mediaop:Normalize id="vo-relabel" source={vo-relabel-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <time:Window id="vo-relabel-window" timeline={t.timeline} from={t.relabel} for="35f"/>
  <asset:Audio id="vo-q3-file" src="./voice/q3.mp3"/>
  <mediaop:Normalize id="vo-q3" source={vo-q3-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <time:Window id="vo-q3-window" timeline={t.timeline} from={t.q3} for="66f"/>
  <asset:Audio id="vo-rA-file" src="./voice/rA.mp3"/>
  <mediaop:Normalize id="vo-rA" source={vo-rA-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <time:Window id="vo-rA-window" timeline={t.timeline} from={t.rA} for="80f"/>
  <asset:Audio id="vo-rR-file" src="./voice/rR.mp3"/>
  <mediaop:Normalize id="vo-rR" source={vo-rR-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <time:Window id="vo-rR-window" timeline={t.timeline} from={t.rR} for="94f"/>
  <asset:Audio id="vo-rE-file" src="./voice/rE.mp3"/>
  <mediaop:Normalize id="vo-rE" source={vo-rE-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <time:Window id="vo-rE-window" timeline={t.timeline} from={t.rE} for="169f"/>
  <asset:Audio id="vo-nice-file" src="./voice/nice.mp3"/>
  <mediaop:Normalize id="vo-nice" source={vo-nice-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <time:Window id="vo-nice-window" timeline={t.timeline} from={t.nice} for="70f"/>
  <asset:Audio id="vo-ctacard-file" src="./voice/ctacard.mp3"/>
  <mediaop:Normalize id="vo-ctacard" source={vo-ctacard-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <time:Window id="vo-ctacard-window" timeline={t.timeline} from={t.ctacard} for="102f"/>
  <audio:Track id="voiceover" timeline={t.timeline}>
    <audio:Clip id="vo-hook-clip" source={vo-hook.media} during={vo-hook-window}/>
    <audio:Clip id="vo-q1-clip" source={vo-q1.media} during={vo-q1-window}/>
    <audio:Clip id="vo-a1-clip" source={vo-a1.media} during={vo-a1-window}/>
    <audio:Clip id="vo-q2-clip" source={vo-q2.media} during={vo-q2-window}/>
    <audio:Clip id="vo-a2-clip" source={vo-a2.media} during={vo-a2-window}/>
    <audio:Clip id="vo-t1-clip" source={vo-t1.media} during={vo-t1-window}/>
    <audio:Clip id="vo-t2-clip" source={vo-t2.media} during={vo-t2-window}/>
    <audio:Clip id="vo-t3-clip" source={vo-t3.media} during={vo-t3-window}/>
    <audio:Clip id="vo-tA-clip" source={vo-tA.media} during={vo-tA-window}/>
    <audio:Clip id="vo-tR-clip" source={vo-tR.media} during={vo-tR-window}/>
    <audio:Clip id="vo-tE-clip" source={vo-tE.media} during={vo-tE-window}/>
    <audio:Clip id="vo-relabel-clip" source={vo-relabel.media} during={vo-relabel-window}/>
    <audio:Clip id="vo-q3-clip" source={vo-q3.media} during={vo-q3-window}/>
    <audio:Clip id="vo-rA-clip" source={vo-rA.media} during={vo-rA-window}/>
    <audio:Clip id="vo-rR-clip" source={vo-rR.media} during={vo-rR-window}/>
    <audio:Clip id="vo-rE-clip" source={vo-rE.media} during={vo-rE-window}/>
    <audio:Clip id="vo-nice-clip" source={vo-nice.media} during={vo-nice-window}/>
    <audio:Clip id="vo-ctacard-clip" source={vo-ctacard.media} during={vo-ctacard-window}/>
  </audio:Track>

  <film:Film id="main" canvas={canvas.canvas} timeline={t.timeline} appearance={look.film.main}>
    <film:Track source={lesson.visual}/>
    <film:Track source={voiceover.audio}/>
  </film:Film>
  <html:Video id="final" composition={main.composition} timeline={t.timeline}/>
</svml>
