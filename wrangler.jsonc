{
  // Static site served by Cloudflare Workers, plus a small API for the homework LMS (/homework/).
  // Only /api/* runs the Worker (worker/index.ts); every other path is a static file from ./dist.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "upwind",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "upwind.asia", "custom_domain": true },
    { "pattern": "www.upwind.asia", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  // D1 database "upwind-homework" (created 2026-11-05, region APAC).
  // Migrations (./migrations) are applied with `npx wrangler d1 migrations apply DB --remote`.
  // Secrets, set in the dashboard (Workers > upwind > Settings > Variables and Secrets), never in this file:
  //   TEACHER_CODE    password for /homework/#/giao-vien
  //   SESSION_SECRET  long random string that signs login cookies
  "d1_databases": [
    { "binding": "DB", "database_name": "upwind-homework", "database_id": "ff64b7c7-9967-4e76-a70b-00d0addcadaf", "migrations_dir": "migrations" }
  ]
}
