{
  // Static site served by Cloudflare Workers (static assets only, no Worker code).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "upwind",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "upwind.asia", "custom_domain": true },
    { "pattern": "www.upwind.asia", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
